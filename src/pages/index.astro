---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/content.js';
import { LINKS } from '../site.js';

import devices from '../../content/pages/images/devices.jpg';
import pollution from '../assets/pollution.jpg';
import openSource from '../assets/illustrations/open-source.svg';
import serverStatus from '../assets/illustrations/server-status.svg';
import workChat from '../assets/illustrations/work-chat.svg';

const posts = (await getPosts()).slice(0, 3);

const sensors = [
  { symbol: 'CO₂', name: 'Carbon dioxide' },
  { symbol: 'CH₄', name: 'Methane' },
  { symbol: 'CO', name: 'Carbon monoxide' },
  { symbol: 'PM1', name: 'Ultrafine particles' },
  { symbol: 'PM2.5', name: 'Fine particles' },
  { symbol: 'PM10', name: 'Coarse particles' },
  { symbol: 'VOC', name: 'Volatile organic compounds' },
  { symbol: '°C', name: 'Temperature' },
  { symbol: '%RH', name: 'Humidity' },
  { symbol: 'hPa', name: 'Pressure' },
];

const features = [
  {
    title: 'Open hardware devices',
    text: 'Build your own devices using detailed guides and open-source schematics.',
    image: openSource,
    alt: 'Illustration of open-source hardware and circuit schematics',
    href: '/docs/',
    cta: 'Read the guides',
  },
  {
    title: 'Global data network',
    text: 'Access and share real-time, crowdsourced air quality data from around the world.',
    image: serverStatus,
    alt: 'Illustration of networked servers sharing air quality data',
    href: LINKS.app,
    cta: 'Open the app',
  },
  {
    title: 'Community collaboration',
    text: 'Join makers, researchers, and activists working together for climate action.',
    image: workChat,
    alt: 'Illustration of people collaborating through an online chat',
    href: LINKS.github,
    cta: 'Join on GitHub',
  },
];

// Deterministic "air particles" for the hero background (pure CSS animation).
const particles = Array.from({ length: 18 }, (_, i) => {
  const r = (n: number) => ((Math.sin(i * 97.13 + n * 13.7) + 1) / 2);
  return {
    left: `${Math.round(r(1) * 100)}%`,
    top: `${Math.round(r(2) * 100)}%`,
    size: `${(2 + r(3) * 5).toFixed(1)}px`,
    delay: `${(-r(4) * 18).toFixed(1)}s`,
    duration: `${(14 + r(5) * 14).toFixed(1)}s`,
  };
});
---

<BaseLayout>
  <!-- ============================== HERO ============================== -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true">
      {
        particles.map((p) => (
          <span
            class="hero__particle"
            style={`left:${p.left};top:${p.top};width:${p.size};height:${p.size};animation-delay:${p.delay};animation-duration:${p.duration}`}
          />
        ))
      }
    </div>

    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="eyebrow">Open-source air quality monitoring</span>
        <h1>
          Know what you breathe.
          <span>Act for the planet.</span>
        </h1>
        <p class="hero__lead">
          Aria Watch builds open hardware that measures the air around you, and a community network that
          shares the data — transparent, reliable and free for everyone.
        </p>
        <div class="hero__actions">
          <a class="btn btn--lime" href="/docs/">Get started <Icon name="arrowRight" size={18} /></a>
          <a class="btn btn--outline-light" href="/about/">Learn more</a>
        </div>
        <a class="hero__award" href="/blog/maker_faire_trieste_2025/">
          <span class="hero__award-icon"><Icon name="trophy" size={18} /></span>
          <span><strong>1st prize</strong> · Best project at Maker Faire Trieste 2025</span>
          <Icon name="arrowRight" size={16} />
        </a>
      </div>

      <div class="hero__visual">
        <figure class="hero__photo">
          <Image
            src={devices}
            alt="Aria Watch devices: white solar-powered enclosures and open boards showing the sensors"
            widths={[480, 720, 960, 1200]}
            sizes="(max-width: 900px) 90vw, 520px"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
        <div class="hero__chip hero__chip--a"><Icon name="sun" size={16} /> Solar powered</div>
        <div class="hero__chip hero__chip--b"><Icon name="chip" size={16} /> Open hardware · ESP32-S3</div>
        <div class="hero__chip hero__chip--c"><span class="pulse" aria-hidden="true"></span> Measuring 10 parameters</div>
      </div>
    </div>
  </section>

  <!-- ============================ SENSORS ============================= -->
  <section class="container section sensors" aria-labelledby="sensors-title">
    <div class="section__head">
      <div>
        <span class="eyebrow">What it measures</span>
        <h2 id="sensors-title">Ten numbers that tell the truth about the air.</h2>
      </div>
      <p>
        Advanced sensors track gases, particulate matter and climate conditions, inside weather-resistant
        enclosures with easily replaceable filters.
      </p>
    </div>
    <ul class="sensors__grid">
      {
        sensors.map((s) => (
          <li class="sensor">
            <span class="sensor__symbol">{s.symbol}</span>
            <span class="sensor__name">{s.name}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============================ MISSION ============================= -->
  <section class="container section">
    <div class="mission">
      <Image
        class="mission__bg"
        src={pollution}
        alt=""
        widths={[640, 1024, 1440, 1920]}
        sizes="(max-width: 1180px) 100vw, 1180px"
      />
      <div class="mission__content">
        <span class="eyebrow eyebrow--light">Our mission</span>
        <h2>Breathe the truth.</h2>
        <p>
          Accurate, accessible environmental data is essential in the fight against climate change. Aria
          Watch combats misinformation with precise air quality measurements from open devices and a
          collaborative global network.
        </p>
        <a class="btn btn--lime" href="/about/">Read our story <Icon name="arrowRight" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- ============================ FEATURES ============================ -->
  <section class="container section" aria-labelledby="features-title">
    <div class="section__head">
      <div>
        <span class="eyebrow">Open by design</span>
        <h2 id="features-title">Hardware, data and people — all in the open.</h2>
      </div>
      <p>
        All designs, schematics, firmware and assembly instructions are freely available to anyone who
        wants to build, modify or improve their own device.
      </p>
    </div>
    <div class="features">
      {
        features.map((f) => (
          <a
            class="card feature"
            href={f.href}
            {...(f.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
          >
            <div class="feature__art">
              <Image src={f.image} alt={f.alt} width={360} />
            </div>
            <div class="feature__body">
              <h3>{f.title}</h3>
              <p>{f.text}</p>
              <span class="post-card__more">
                {f.cta} <Icon name="arrowRight" size={16} />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ============================== BLOG ============================== -->
  <section class="container section" aria-labelledby="blog-title">
    <div class="section__head">
      <div>
        <span class="eyebrow">From the blog</span>
        <h2 id="blog-title">On the road with Aria Watch.</h2>
      </div>
      <a class="btn btn--ghost" href="/blog/">All posts <Icon name="arrowRight" size={18} /></a>
    </div>
    <div class="grid-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <!-- =============================== CTA ============================== -->
  <section class="container section">
    <div class="cta">
      <div>
        <span class="eyebrow eyebrow--light">Join the movement</span>
        <h2>Build it. Measure it. Share it.</h2>
        <p>Contribute, build, and make a difference with Aria Watch. Every new device makes the map sharper.</p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--lime" href={LINKS.contribute} target="_blank" rel="noopener">
          <Icon name="github" size={18} /> Get involved on GitHub
        </a>
        <a class="btn btn--outline-light" href={LINKS.instagram} target="_blank" rel="noopener">
          <Icon name="instagram" size={18} /> Follow on Instagram
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Shared bits for the always-dark brand surfaces (hero, mission, CTA) */
  .btn--lime {
    background: var(--leaf-bright);
    color: var(--forest-950);
  }
  .btn--lime:hover {
    background: #bdf07e;
  }
  .btn--outline-light {
    color: #f1f6ee;
    border-color: rgb(255 255 255 / 0.35);
  }
  .btn--outline-light:hover {
    border-color: #fff;
    background: rgb(255 255 255 / 0.06);
  }
  .eyebrow--light {
    color: var(--leaf-bright);
  }

  /* ------------------------------ Hero ------------------------------ */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #f1f6ee;
    background:
      radial-gradient(60% 70% at 80% 30%, rgb(114 183 47 / 0.28), transparent 70%),
      radial-gradient(50% 60% at 0% 100%, rgb(27 74 46 / 0.9), transparent 70%),
      linear-gradient(180deg, var(--forest-950), var(--forest-900));
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(70% 80% at 60% 40%, #000 30%, transparent 80%);
  }
  .hero__particle {
    position: absolute;
    border-radius: 50%;
    background: var(--leaf-bright);
    opacity: 0;
    filter: blur(0.5px);
    animation: drift linear infinite;
  }
  @keyframes drift {
    0% {
      transform: translate3d(0, 30px, 0);
      opacity: 0;
    }
    15% {
      opacity: 0.55;
    }
    85% {
      opacity: 0.35;
    }
    100% {
      transform: translate3d(40px, -160px, 0);
      opacity: 0;
    }
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(4rem, 10vw, 8rem) clamp(4rem, 9vw, 7rem);
  }
  .hero h1 {
    margin-top: var(--space-5);
    font-size: clamp(2.9rem, 7.2vw, 5.6rem);
    font-weight: 750;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .hero h1 span {
    display: block;
    background: linear-gradient(90deg, var(--leaf-bright), #d8f7a8 60%, var(--leaf-bright));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero .eyebrow {
    color: var(--leaf-bright);
  }
  .hero__lead {
    margin-top: var(--space-5);
    max-width: 34rem;
    font-size: clamp(1.1rem, 1.8vw, 1.25rem);
    color: rgb(241 246 238 / 0.78);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .hero__award {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-7);
    padding: 0.45rem 1rem 0.45rem 0.45rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.12);
    color: rgb(241 246 238 / 0.88);
    font-size: 0.92rem;
    text-decoration: none;
    transition: background-color 0.2s, border-color 0.2s;
  }
  .hero__award:hover {
    background: rgb(255 255 255 / 0.1);
    border-color: rgb(255 255 255 / 0.25);
  }
  .hero__award strong {
    color: #fff;
  }
  .hero__award-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--ember);
    color: var(--forest-950);
  }

  .hero__visual {
    position: relative;
    justify-self: center;
    width: min(100%, 520px);
  }
  .hero__photo {
    margin: 0;
    border-radius: var(--radius-xl);
    overflow: hidden;
    transform: rotate(2deg);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 40px 80px -30px rgb(0 0 0 / 0.7),
      0 0 120px -20px rgb(114 183 47 / 0.35);
  }
  .hero__photo img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  .hero__chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.95rem;
    border-radius: var(--radius-pill);
    background: rgb(8 24 15 / 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgb(255 255 255 / 0.14);
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
    box-shadow: 0 12px 30px -12px rgb(0 0 0 / 0.6);
    animation: bob 6s ease-in-out infinite;
  }
  .hero__chip .icon {
    color: var(--leaf-bright);
  }
  .hero__chip--a {
    top: 8%;
    left: -8%;
  }
  .hero__chip--b {
    bottom: 16%;
    right: -6%;
    animation-delay: -2s;
  }
  .hero__chip--c {
    bottom: -4%;
    left: 6%;
    animation-delay: -4s;
  }
  .pulse {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--leaf-bright);
    box-shadow: 0 0 0 0 rgb(166 227 95 / 0.7);
    animation: pulse 2s infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(-8px);
    }
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 10px rgb(166 227 95 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(166 227 95 / 0);
    }
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__visual {
      width: min(100%, 420px);
      margin-top: var(--space-5);
    }
    .hero__chip--a {
      left: -2%;
    }
    .hero__chip--b {
      right: -2%;
    }
  }

  /* ----------------------------- Sensors ---------------------------- */
  .sensors__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--border);
    border: 1px solid var(--border);
  }
  .sensor {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 9.5rem;
    padding: var(--space-5);
    background: var(--surface);
    transition: background-color 0.25s;
  }
  .sensor:hover {
    background: var(--accent-soft);
  }
  .sensor__symbol {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text);
  }
  .sensor:hover .sensor__symbol {
    color: var(--accent);
  }
  .sensor__name {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.35;
  }
  @media (max-width: 900px) {
    .sensors__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .sensor {
      min-height: 7.5rem;
    }
  }

  /* ----------------------------- Mission ---------------------------- */
  .mission {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(30rem, 60vw, 38rem);
    display: flex;
    align-items: flex-end;
    border-radius: var(--radius-xl);
    color: #f6efe4;
  }
  .mission__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 30%;
    z-index: -2;
  }
  .mission::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(20 10 2 / 0.88) 0%, rgb(20 10 2 / 0.55) 45%, rgb(20 10 2 / 0.05) 80%),
      linear-gradient(0deg, rgb(20 10 2 / 0.6), transparent 50%);
  }
  .mission__content {
    max-width: 34rem;
    padding: clamp(1.75rem, 5vw, 4rem);
  }
  .mission .eyebrow {
    color: #ffc875;
  }
  .mission h2 {
    margin-top: var(--space-4);
    font-size: clamp(2.6rem, 6.5vw, 4.75rem);
    letter-spacing: -0.045em;
  }
  .mission p {
    margin-block: var(--space-5) var(--space-6);
    font-size: 1.1rem;
    color: rgb(246 239 228 / 0.85);
  }
  @media (max-width: 700px) {
    .mission::after {
      background: linear-gradient(0deg, rgb(20 10 2 / 0.92) 25%, rgb(20 10 2 / 0.35) 75%, rgb(20 10 2 / 0.1));
    }
  }

  /* ---------------------------- Features ---------------------------- */
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--space-5);
  }
  .feature__art {
    display: grid;
    place-items: center;
    height: 14rem;
    padding: var(--space-5) var(--space-6);
    background:
      radial-gradient(70% 70% at 50% 60%, rgb(114 183 47 / 0.16), transparent 70%),
      #eef4e8;
  }
  [data-theme='dark'] .feature__art {
    background:
      radial-gradient(70% 70% at 50% 60%, rgb(114 183 47 / 0.25), transparent 70%),
      #dfe9d7;
  }
  .feature__art img {
    height: 100%;
    width: auto;
    max-width: 100%;
    max-height: none;
    aspect-ratio: auto;
    object-fit: contain;
    min-height: 0;
    transition: transform 0.5s var(--ease);
  }
  a.feature:hover .feature__art img {
    transform: scale(1.05) translateY(-4px);
  }
  .feature__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-5) var(--space-6);
    flex: 1;
  }
  .feature h3 {
    font-size: 1.4rem;
  }
  .feature p {
    color: var(--muted);
  }

  /* ------------------------------- CTA ------------------------------ */
  .cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1.3fr auto;
    align-items: center;
    gap: var(--space-6);
    padding: clamp(2rem, 6vw, 4.5rem);
    border-radius: var(--radius-xl);
    color: #f1f6ee;
    background:
      radial-gradient(60% 120% at 100% 0%, rgb(114 183 47 / 0.35), transparent 60%),
      linear-gradient(135deg, var(--forest-900), var(--forest-800));
  }
  .cta::before {
    content: '';
    position: absolute;
    right: -6rem;
    bottom: -8rem;
    width: 24rem;
    height: 24rem;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.08);
    box-shadow:
      0 0 0 3rem rgb(255 255 255 / 0.02),
      0 0 0 6rem rgb(255 255 255 / 0.015);
    z-index: -1;
  }
  .cta h2 {
    margin-top: var(--space-4);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    letter-spacing: -0.04em;
  }
  .cta p {
    margin-top: var(--space-4);
    max-width: 40ch;
    color: rgb(241 246 238 / 0.78);
    font-size: 1.1rem;
  }
  .cta__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  @media (max-width: 860px) {
    .cta {
      grid-template-columns: 1fr;
    }
    .cta__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
